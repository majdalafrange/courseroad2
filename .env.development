VITE_URL=http://localhost:8080
# Same catalog and requirements the deployed app reads (staging and
# production both point here). fireroad-dev.mit.edu carries stale
# requirement files: its major6-2new still lists the pre-2022 Course 6
# numbers (6.0001, 6.006, 6.0004), so developing against it showed course
# numbers that no longer exist. Reads are public; run `npm run devdev`
# against a local FireRoad if you need to exercise writes.
VITE_FIREROAD_URL=https://fireroad.mit.edu
