{
  "name": "courseroad",
  "version": "2.0.0",
  "description": "Degree planning for MIT undergrads",
  "author": "courseroad-dev team",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "devdev": "vite dev --mode devdev",
    "build-dev": "vite build --mode staging",
    "build-prod": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "palette": "node scripts/generate-palette.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify/vue": "^5.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-plugin-cache-persister": "^1.1.1",
    "@pinia/colada-plugin-retry": "^1.0.2",
    "axios": "^1.19.0",
    "idb-keyval": "^6.3.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.3",
    "ua-parser-js": "^2.0.10",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.125",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "moment": "^2.30.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "bugs": {
    "url": "https://github.com/sipb/courseroad2/issues"
  },
  "homepage": "https://courseroad.mit.edu",
  "keywords": [
    "mit",
    "courseroad"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sipb/courseroad2.git"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true
  }
}
