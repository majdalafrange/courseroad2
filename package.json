{
  "name": "courseroad",
  "version": "2.0.0",
  "description": "Degree planning for MIT undergrads",
  "author": "courseroad-dev team",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "devdev": "vite dev --mode devdev",
    "build-dev": "vite build --mode staging --base /dev",
    "build-prod": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "palette": "node scripts/generate-palette.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@msgpack/msgpack": "^3.1.3",
    "axios": "^1.19.0",
    "pinia": "^2.2.2",
    "ua-parser-js": "^1.0.41",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/coverage-v8": "~2.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^15.15.0",
    "jsdom": "^24.1.0",
    "moment": "^2.29.4",
    "prettier": "3.2.5",
    "puppeteer-core": "^25.1.0",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.2.11",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.29"
  },
  "bugs": {
    "url": "https://github.com/sipb/courseroad2/issues"
  },
  "homepage": "https://courseroad.mit.edu",
  "keywords": [
    "mit",
    "courseroad"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sipb/courseroad2.git"
  }
}
